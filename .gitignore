# Standard .gitignore for Python, PyInstaller, and VSCode

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# PyInstaller
*.manifest

# Installer output
release/
dist/
build/

# Visual Studio / JetBrains IDE files
.vs/
.vscode/
.idea/

# Backups (generated by gen.backup.py)
backups/

# Environment files
.env
.env.*

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Project-specific
github_sync.py
installer.iss
build_app.py
