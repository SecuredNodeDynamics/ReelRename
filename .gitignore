#!/usr/bin/env python3
"""
github_sync.py
Auto-sync a local git repo (e.g., ReelRename) to GitHub.

Typical use:
  python github_sync.py
  python github_sync.py --path "C:/Users/artyo/PycharmProjects/ReelRename" --message "Quick fixes"
  python github_sync.py --no-pull
  python github_sync.py --no-stash
  python github_sync.py --remote origin --branch main

Notes:
- Requires Git installed and available on PATH.
- Assumes the repo already has a remote (default: origin).
- This script ensures it is excluded from Git via .gitignore and removed from tracking.
- To avoid "cannot pull with rebase: You have unstaged changes", this script auto-stashes by default.
"""

from __future__ import annotations

import argparse
import subprocess
import sys
from datetime import datetime
from pathlib import Path
from typing import List, Optional, Tuple

SCRIPT_NAME = "github_sync.py"


def run_git(args: List[str], cwd: Path) -> Tuple[int, str, str]:
    """Run a git command and return (returncode, stdout, stderr)."""
    cmd = ["git"] + args
    p = subprocess.run(
        cmd,
        cwd=str(cwd),
        text=True,
        capture_output=True,
        shell=False,
    )
    return p.returncode, (p.stdout or "").strip(), (p.stderr or "").strip()


def fail(msg: str, code: int = 1) -> None:
    print(f"[ERROR] {msg}", file=sys.stderr)
    sys.exit(code)


def info(msg: str) -> None:
    print(f"[INFO] {msg}")


def ok(msg: str) -> None:
    print(f"[OK]   {msg}")


def is_git_repo(cwd: Path) -> bool:
    rc, out, _ = run_git(["rev-parse", "--is-inside-work-tree"], cwd=cwd)
    return rc == 0 and out.lower() == "true"


def current_branch(cwd: Path) -> Optional[str]:
    rc, out, _ = run_git(["rev-parse", "--abbrev-ref", "HEAD"], cwd=cwd)
    if rc != 0:
        return None
    return out


def has_remote(cwd: Path, remote: str) -> bool:
    rc, out, _ = run_git(["remote"], cwd=cwd)
    if rc != 0:
        return False
    remotes = {r.strip() for r in out.splitlines() if r.strip()}
    return remote in remotes


def status_porcelain(cwd: Path) -> str:
    rc, out, err = run_git(["status", "--porcelain"], cwd=cwd)
    if rc != 0:
        fail(f"Failed to read status. Git said: {err}")
    return out.strip()


def working_tree_dirty(cwd: Path) -> bool:
    return bool(status_porcelain(cwd))


def ensure_script_is_ignored(repo_path: Path) -> None:
    """
    Ensure github_sync.py is ignored and not tracked.
    - Adds SCRIPT_NAME to .gitignore if missing.
    - Removes SCRIPT_NAME from git index if it was previously tracked.
    """
    gitignore_path = repo_path / ".gitignore"

    existing_lines: List[str] = []
    if gitignore_path.exists():
        try:
            existing_lines = gitignore_path.read_text(encoding="utf-8").splitlines()
        except Exception:
            existing_lines = gitignore_path.read_bytes().decode("utf-8", errors="ignore").splitlines()

    if SCRIPT_NAME not in existing_lines:
        info(f"Adding {SCRIPT_NAME} to .gitignore...")
        with gitignore_path.open("a", encoding="utf-8") as f:
            if existing_lines and existing_lines[-1].strip() != "":
                f.write("\n")
            f.write(f"{SCRIPT_NAME}\n")
        ok(f"Added {SCRIPT_NAME} to .gitignore.")
    else:
        ok(f"{SCRIPT_NAME} already present in .gitignore.")

    # If tracked, untrack (keep file locally)
    rc, _, _ = run_git(["ls-files", "--error-unmatch", SCRIPT_NAME], cwd=repo_path)
    if rc == 0:
        info(f"{SCRIPT_NAME} is tracked. Removing from Git index (keeping local file)...")
        rc2, out2, err2 = run_git(["rm", "--cached", "--quiet", SCRIPT_NAME], cwd=repo_path)
        if rc2 != 0:
            fail(f"Failed to untrack {SCRIPT_NAME}. Git said: {err2 or out2}")
        ok(f"Untracked {SCRIPT_NAME}. It will no longer upload to GitHub.")
    else:
        ok(f"{SCRIPT_NAME} is not tracked (good).")


def stash_push_if_needed(repo_path: Path) -> bool:
    """
    Stash tracked + untracked changes. Returns True if a stash was created.
    """
    if not working_tree_dirty(repo_path):
        return False

    stamp = datetime.now().strftime("%Y-%m-%d %H:%M:%S")
    msg = f"github_sync auto-stash {stamp}"
    info("Local changes detected. Stashing them so pull/rebase can run...")
    rc, out, err = run_git(["stash", "push", "-u", "-m", msg], cwd=repo_path)
    if rc != 0:
        fail(f"Failed to stash changes. Git said: {err or out}")

    if "No local changes to save" in (out + err):
        ok("Nothing to stash.")
        return False

    ok("Stashed.")
    return True


def stash_pop(repo_path: Path) -> None:
    info("Restoring stashed changes (stash pop)...")
    rc, out, err = run_git(["stash", "pop"], cwd=repo_path)
    if rc != 0:
        fail(
            "Stash pop failed (usually conflicts). Resolve conflicts, then run again.\n\n"
            f"Git said: {err or out}"
        )
    ok("Stash restored.")


def ensure_upstream(cwd: Path, remote: str, branch: str) -> None:
    rc, _, _ = run_git(["rev-parse", "--abbrev-ref", "--symbolic-full-name", "@{u}"], cwd=cwd)
    if rc == 0:
        return

    info(f"No upstream set for '{branch}'. Setting upstream to '{remote}/{branch}'...")
    rc, out, err = run_git(["push", "-u", remote, branch], cwd=cwd)
    if rc != 0:
        fail(f"Failed to set upstream. Git said: {err or out}")
    ok("Upstream set.")


def main() -> None:
    parser = argparse.ArgumentParser(description="Auto-sync a repo to GitHub via stash/pull/add/commit/push.")
    parser.add_argument("--path", default=".", help="Path to the repo root (default: current directory).")
    parser.add_argument("--remote", default="origin", help="Remote name to push to (default: origin).")
    parser.add_argument("--branch", default=None, help="Branch to push (default: current branch).")
    parser.add_argument("--message", default=None, help="Commit message (default: timestamped 'Auto-sync').")
    parser.add_argument("--no-pull", action="store_true", help="Skip pulling/rebasing before pushing.")
    parser.add_argument("--no-commit", action="store_true", help="Stage changes and push without committing.")
    parser.add_argument("--no-stash", action="store_true", help="Disable auto-stash behavior.")
    args = parser.parse_args()

    repo_path = Path(args.path).expanduser().resolve()
    if not repo_path.exists():
        fail(f"Path does not exist: {repo_path}")

    if not is_git_repo(repo_path):
        fail(
            f"Not a git repository: {repo_path}\n"
            "Fix: run `git init` and add a remote, or point --path at the repo root."
        )
    ok(f"Git repo detected: {repo_path}")

    # Exclude this script from GitHub
    ensure_script_is_ignored(repo_path)

    # Determine branch
    branch = args.branch or current_branch(repo_path)
    if not branch or branch == "HEAD":
        fail("Could not determine current branch. Are you in a detached HEAD state?")
    info(f"Branch: {branch}")

    # Remote sanity check
    remote = args.remote
    if not has_remote(repo_path, remote):
        rc, out, err = run_git(["remote", "-v"], cwd=repo_path)
        details = out if out else (err if err else "(no remotes listed)")
        fail(
            f"Remote '{remote}' not found.\n"
            "Fix: set your GitHub remote, e.g.:\n"
            "  git remote add origin <YOUR_GITHUB_REPO_URL>\n\n"
            f"Current remotes:\n{details}"
        )
    ok(f"Remote: {remote}")

    # Auto-stash before pull/rebase (prevents your current error)
    did_stash = False
    if not args.no_stash:
        did_stash = stash_push_if_needed(repo_path)
    else:
        info("Auto-stash disabled (--no-stash).")

    # Pull/rebase
    if not args.no_pull:
        info("Pulling latest changes (rebase)...")
        rc, out, err = run_git(["pull", "--rebase", remote, branch], cwd=repo_path)
        if rc != 0:
            fail(
                "Pull/rebase failed.\n"
                "If you’re mid-rebase, resolve conflicts then run:\n"
                "  git rebase --continue\n"
                "Or abort:\n"
                "  git rebase --abort\n\n"
                f"Git said: {err or out}"
            )
        ok("Pull/rebase complete.")
    else:
        info("Skipping pull/rebase (--no-pull).")

    # Restore stash after pull
    if did_stash:
        stash_pop(repo_path)

    # Stage everything
    info("Staging changes (git add -A)...")
    rc, _, err = run_git(["add", "-A"], cwd=repo_path)
    if rc != 0:
        fail(f"Failed to stage changes. Git said: {err}")
    ok("Staged.")

    # Commit if needed
    if args.no_commit:
        info("Skipping commit (--no-commit).")
    else:
        rc, status_out, status_err = run_git(["status", "--porcelain"], cwd=repo_path)
        if rc != 0:
            fail(f"Failed to read status. Git said: {status_err}")

        if not status_out.strip():
            ok("No changes to commit. Repo already up to date locally.")
        else:
            commit_msg = args.message or f"Auto-sync: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}"
            info(f"Committing: {commit_msg}")
            rc, out, err = run_git(["commit", "-m", commit_msg], cwd=repo_path)
            if rc != 0:
                combined = (err or "") + ("\n" + out if out else "")
                if "nothing to commit" in combined.lower():
                    ok("Nothing to commit.")
                else:
                    fail(f"Commit failed. Git said:\n{combined.strip()}")
            else:
                ok("Commit created.")

    # Ensure upstream & push
    ensure_upstream(repo_path, remote, branch)

    info("Pushing to GitHub...")
    rc, out, err = run_git(["push", remote, branch], cwd=repo_path)
    if rc != 0:
        fail(
            "Push failed. This is usually authentication, permissions, or a non-fast-forward issue.\n\n"
            f"Git said: {err or out}"
        )
    ok("Push complete. GitHub is updated.")

    rc, log_out, _ = run_git(["log", "-1", "--oneline"], cwd=repo_path)
    if rc == 0 and log_out:
        info(f"Latest commit: {log_out}")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        fail("Cancelled.", code=130)
