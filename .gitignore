#!/usr/bin/env python3
"""
github_sync.py
Auto-sync a local git repo (e.g., ReelRename) to GitHub.

Typical use:
  python github_sync.py
  python github_sync.py --path "C:/Users/artyo/PycharmProjects/ReelRename" --message "Quick fixes"
  python github_sync.py --no-pull
  python github_sync.py --no-stash
  python github_sync.py --remote origin --branch main

Notes:
- Requires Git installed and available on PATH.
- Assumes the repo already has a remote (default: origin).
- This script ensures it is excluded from Git via .gitignore and removed from tracking.
- To avoid "cannot pull with rebase: You have unstaged changes", this script auto-stashes by default.
"""

from __future__ import annotations

import argparse
from datetime import datetime

# Standard .gitignore for Python, PyInstaller, and VSCode
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# PyInstaller
#  Usually these files are written by a python script from a template
#  before PyInstaller builds the exe, so as to inject date/other infos into it.
*.manifest
*.spec

# Installer output
release/
dist/
build/

# VSCode
.vscode/

# Environment files
.env
.env.*

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Project-specific
github_sync.py
installer.iss
screenshots/
        except Exception:
